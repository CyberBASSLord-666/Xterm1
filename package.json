{
  "name": "polliwall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "quality:gate": "npm run lint && npm run typecheck && npm test -- --watchAll=false --passWithNoTests && npm run build -- --configuration=production",
    "performance:assert": "node scripts/assert-initial-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test --ui",
    "e2e:headless": "playwright test",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"**/*.{md,ts,html,css,scss,json,yml,yaml,mjs}\"",
    "format:check": "prettier --check \"**/*.{md,ts,html,css,scss,json,yml,yaml,mjs}\"",
    "preview": "npx serve dist/app/browser -l 4200",
    "pre-deploy": "npm run lint && npm run typecheck && npm test -- --watchAll=false --passWithNoTests && npm run build -- --configuration=production && npm run security:gate",
    "verify:copilot": "bash ./scripts/verify-copilot-settings.sh",
    "security:validate": "bash ./scripts/validate-security.sh",
    "security:gate": "npm run security:validate && npm audit --audit-level=high",
    "prepare": "husky",
    "health-check": "node scripts/health-check.js"
  },
  "dependencies": {
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/service-worker": "^21.2.14",
    "@google/genai": "^2.11.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.17.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/postcss": "^4.0.0-alpha.16",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^17.0.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.38",
    "prettier": "^3.2.0",
    "serve": "^14.2.5",
    "tailwindcss": "^4.0.0-alpha.16",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "vite": "^7.1.11"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json}": [
      "prettier --write"
    ]
  }
}
