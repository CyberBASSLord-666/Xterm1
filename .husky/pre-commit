#!/usr/bin/env sh
# ============================================================================
# Pre-commit Hook for PolliWall (Xterm1)
# ============================================================================
# Runs before each commit to ensure code quality. Validates:
# - Lint-staged files (ESLint + Prettier)
# - TypeScript type checking (strict mode)
#
# To bypass in emergencies: git commit --no-verify
# ============================================================================

echo "🔍 Running pre-commit checks..."

# Run lint-staged for formatting and linting
npx lint-staged

# Run TypeScript type checking (only on staged .ts files)
echo "📝 Running TypeScript type check..."
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)

if [ -n "$STAGED_TS_FILES" ]; then
  TSC_OUTPUT_FILE=$(mktemp)
  npx tsc --noEmit --skipLibCheck > "$TSC_OUTPUT_FILE" 2>&1
  TSC_STATUS=$?
  head -20 "$TSC_OUTPUT_FILE"
  rm -f "$TSC_OUTPUT_FILE"
  if [ $TSC_STATUS -ne 0 ]; then
    echo "❌ TypeScript errors found. Please fix before committing."
    echo "💡 Tip: Run 'npx tsc --noEmit' to see all errors"
    exit 1
  fi
  echo "✅ TypeScript check passed"
else
  echo "ℹ️  No TypeScript files staged, skipping type check"
fi

echo "✅ Pre-commit checks passed!"
