#!/usr/bin/env bash
# ============================================================================
# Pre-push Hook for PolliWall (Xterm1)
# ============================================================================
# Runs before pushing to remote to ensure quality. Validates:
# - All unit tests pass
# - Build succeeds
#
# To bypass in emergencies: git push --no-verify
# ============================================================================

echo "🚀 Running pre-push checks..."

set -o pipefail

# Run unit tests
echo "🧪 Running unit tests..."
npm test -- --watchAll=false --passWithNoTests
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Please fix before pushing."
  exit 1
fi
echo "✅ Unit tests passed"

# Verify build succeeds
echo "🏗️  Verifying build..."
npm run build -- --configuration=production 2>&1 | tail -5
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo "❌ Build failed. Please fix before pushing."
  exit 1
fi
echo "✅ Build verification passed"

echo "✅ Pre-push checks passed! Safe to push."
